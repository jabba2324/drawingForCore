<Project Sdk="Microsoft.NET.Sdk">

  <!-- Microsoft.DotNet.RemoteExecutor (dotnet/arcade 565a800, release/6.0), from the external/arcade submodule. MIT. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <AssemblyName>Microsoft.DotNet.RemoteExecutor</AssemblyName>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.assert" Version="2.4.1" />
    <!-- As arcade's csproj: ClrMD, for the stack dump RemoteInvokeHandle writes when a remote process times out. -->
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="1.0.5" />
  </ItemGroup>
  <!-- Microsoft's files from the external/ submodules (xforcore forks, drawingforcore branches), at their old paths. -->
  <ItemGroup>
    <Compile Include="../../external/arcade/src/Microsoft.DotNet.RemoteExecutor/src/MiniDump.cs" Link="MiniDump.cs" />
    <Compile Include="../../external/arcade/src/Microsoft.DotNet.RemoteExecutor/src/PasteArguments.cs" Link="PasteArguments.cs" />
    <Compile Include="../../external/arcade/src/Microsoft.DotNet.RemoteExecutor/src/Program.cs" Link="Program.cs" />
    <Compile Include="../../external/arcade/src/Microsoft.DotNet.RemoteExecutor/src/RemoteExecutionException.cs" Link="RemoteExecutionException.cs" />
    <Compile Include="../../external/arcade/src/Microsoft.DotNet.RemoteExecutor/src/RemoteExecutor.cs" Link="RemoteExecutor.cs" />
    <Compile Include="../../external/arcade/src/Microsoft.DotNet.RemoteExecutor/src/RemoteInvokeHandle.cs" Link="RemoteInvokeHandle.cs" />
    <Compile Include="../../external/arcade/src/Microsoft.DotNet.RemoteExecutor/src/RemoteInvokeOptions.cs" Link="RemoteInvokeOptions.cs" />
  </ItemGroup>
</Project>
